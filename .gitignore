# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# claude code — keep rules, exclude conversation history and scratch checkouts
.claude/projects/
.claude/settings.local.json
.claude/worktrees/

# source images for the TFM deck — embedded as data URIs in the generated HTML,
# so the deck is self-contained and these don't need to travel with the repo
screenshots/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
